# Public PayPal client ID used by the browser SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Server-only PayPal REST credentials (never expose the secret with NEXT_PUBLIC_)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_ENVIRONMENT=sandbox
# Optional override; normally leave unset for sandbox/production auto-selection
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI contract parsing and evidence evaluation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Operator confirmation protects capture and void actions
OUTCOME_ACCESS_PASSWORD=choose-a-strong-operator-password
OUTCOME_SESSION_SECRET=replace-with-a-long-random-secret

# SQLite file path. On Render, mount a persistent disk at /var/data
OUTCOME_DB_PATH=./data/outcome.sqlite

# Optional sponsor integrations
ELASTICSEARCH_URL=https://your-elasticsearch-deployment.example
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
POSTMAN_WEBHOOK_SECRET=your_postman_integration_secret
KERNEL_WEBHOOK_SECRET=your_kernel_agent_webhook_secret
